@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix eb:   <https://github.com/divaspoudel0/enterprise-brain-knowledge-graph-retrieval/ontology#> .
@base        <https://github.com/divaspoudel0/enterprise-brain-knowledge-graph-retrieval/ontology> .

<> a owl:Ontology ;
    rdfs:label "Enterprise Brain Ontology" ;
    rdfs:comment "OWL 2 DL schema for the Enterprise Brain synthetic enterprise dataset (Customer, Order, Payment, Complaint, Product). Encodes the minimum viable schema of DATA_PIPELINE.md section 1.1, with inverse properties and cardinality restrictions so multi-hop (2-3) ground-truth paths are always well-formed." ;
    owl:versionInfo "1.0" .

############################################
# Classes
############################################

eb:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "A person who places orders and may file complaints." .

eb:Order a owl:Class ;
    rdfs:label "Order" ;
    rdfs:comment "A purchase order placed by a customer for a single product." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty eb:orderPlacedBy ; owl:cardinality 1 ],
        [ a owl:Restriction ; owl:onProperty eb:forProduct ;   owl:cardinality 1 ] .

eb:Payment a owl:Class ;
    rdfs:label "Payment" ;
    rdfs:comment "A payment against an order. Status is one of the string values {paid, overdue, failed} enforced as a data-level constraint in S2." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty eb:paymentForOrder ; owl:cardinality 1 ] .

eb:Complaint a owl:Class ;
    rdfs:label "Complaint" ;
    rdfs:comment "A customer complaint about an order, filed by exactly one customer." ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty eb:complaintFiledBy ; owl:cardinality 1 ],
        [ a owl:Restriction ; owl:onProperty eb:aboutOrder ;       owl:cardinality 1 ] .

eb:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A product that can be ordered." .

############################################
# Object properties (relationships)
############################################

eb:placedOrder a owl:ObjectProperty ;
    rdfs:label "placed order" ;
    rdfs:comment "Customer -PLACED-> Order." ;
    rdfs:domain eb:Customer ;
    rdfs:range  eb:Order ;
    owl:inverseOf eb:orderPlacedBy .

eb:orderPlacedBy a owl:ObjectProperty ;
    rdfs:label "order placed by" ;
    rdfs:comment "Order -PLACED_BY-> Customer (inverse of placedOrder)." ;
    rdfs:domain eb:Order ;
    rdfs:range  eb:Customer ;
    owl:inverseOf eb:placedOrder .

eb:forProduct a owl:ObjectProperty ;
    rdfs:label "for product" ;
    rdfs:comment "Order -FOR-> Product." ;
    rdfs:domain eb:Order ;
    rdfs:range  eb:Product ;
    owl:inverseOf eb:productOrderedIn .

eb:productOrderedIn a owl:ObjectProperty ;
    rdfs:label "product ordered in" ;
    rdfs:comment "Product -ORDERED_IN-> Order (inverse of forProduct)." ;
    rdfs:domain eb:Product ;
    rdfs:range  eb:Order ;
    owl:inverseOf eb:forProduct .

eb:hasPayment a owl:ObjectProperty ;
    rdfs:label "has payment" ;
    rdfs:comment "Order -HAS_PAYMENT-> Payment." ;
    rdfs:domain eb:Order ;
    rdfs:range  eb:Payment ;
    owl:inverseOf eb:paymentForOrder .

eb:paymentForOrder a owl:ObjectProperty ;
    rdfs:label "payment for order" ;
    rdfs:comment "Payment -FOR_ORDER-> Order (inverse of hasPayment)." ;
    rdfs:domain eb:Payment ;
    rdfs:range  eb:Order ;
    owl:inverseOf eb:hasPayment .

eb:filedComplaint a owl:ObjectProperty ;
    rdfs:label "filed complaint" ;
    rdfs:comment "Customer -FILED-> Complaint." ;
    rdfs:domain eb:Customer ;
    rdfs:range  eb:Complaint ;
    owl:inverseOf eb:complaintFiledBy .

eb:complaintFiledBy a owl:ObjectProperty ;
    rdfs:label "complaint filed by" ;
    rdfs:comment "Complaint -FILED_BY-> Customer (inverse of filedComplaint)." ;
    rdfs:domain eb:Complaint ;
    rdfs:range  eb:Customer ;
    owl:inverseOf eb:filedComplaint .

eb:aboutOrder a owl:ObjectProperty ;
    rdfs:label "about order" ;
    rdfs:comment "Complaint -ABOUT-> Order." ;
    rdfs:domain eb:Complaint ;
    rdfs:range  eb:Order ;
    owl:inverseOf eb:orderComplainedAbout .

eb:orderComplainedAbout a owl:ObjectProperty ;
    rdfs:label "order complained about" ;
    rdfs:comment "Order -COMPLAINED_ABOUT-> Complaint (inverse of aboutOrder)." ;
    rdfs:domain eb:Order ;
    rdfs:range  eb:Complaint ;
    owl:inverseOf eb:aboutOrder .

############################################
# Data properties
############################################

eb:source_record_id a owl:DatatypeProperty ;
    rdfs:label "source record id" ;
    rdfs:comment "Provenance (DATA_PIPELINE.md section 2): the id of the original generated row this node was derived from. Relationships carry the same pointer on the edge (Neo4j) or via the inverse property in the instance graph (RDF)." ;
    rdfs:range xsd:string .

eb:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:comment "Entity-local row id (customer_id, order_id, ...)." ;
    rdfs:range xsd:string .

eb:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "Customer name or Product name." ;
    rdfs:range xsd:string .

eb:region a owl:DatatypeProperty ;
    rdfs:label "region" ;
    rdfs:comment "Customer region." ;
    rdfs:range xsd:string .

eb:signup_date a owl:DatatypeProperty ;
    rdfs:label "signup date" ;
    rdfs:comment "Customer signup date." ;
    rdfs:range xsd:date .

eb:order_date a owl:DatatypeProperty ;
    rdfs:label "order date" ;
    rdfs:comment "Date the order was placed." ;
    rdfs:range xsd:date .

eb:amount a owl:DatatypeProperty ;
    rdfs:label "amount" ;
    rdfs:comment "Order or payment amount." ;
    rdfs:range xsd:decimal .

eb:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "Order status or payment status. Payment status values {paid, overdue, failed} are enforced as a data-level constraint in S2, not as an ontology enumeration." ;
    rdfs:range xsd:string .

eb:due_date a owl:DatatypeProperty ;
    rdfs:label "due date" ;
    rdfs:comment "Payment due date." ;
    rdfs:range xsd:date .

eb:paid_date a owl:DatatypeProperty ;
    rdfs:label "paid date" ;
    rdfs:comment "Payment paid date (absent until paid)." ;
    rdfs:range xsd:date .

eb:filed_date a owl:DatatypeProperty ;
    rdfs:label "filed date" ;
    rdfs:comment "Date the complaint was filed." ;
    rdfs:range xsd:date .

eb:category a owl:DatatypeProperty ;
    rdfs:label "category" ;
    rdfs:comment "Complaint category or product category." ;
    rdfs:range xsd:string .

eb:price a owl:DatatypeProperty ;
    rdfs:label "price" ;
    rdfs:comment "Product unit price." ;
    rdfs:range xsd:decimal .

eb:free_text_description a owl:DatatypeProperty ;
    rdfs:label "free text description" ;
    rdfs:comment "Free-text field (e.g. complaint description). Exactly this field is derived from the structured record it annotates (DATA_PIPELINE.md section 1.2)." ;
    rdfs:range xsd:string .
